{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "stellarwp/changelog-embed",
    "version": "0.1.0",
    "title": "Stellar Changelog Embed",
    "category": "embed",
    "icon": "text",
    "description": "Embed a changelog text file as content.",
    "example": {},
    "supports": {
        "html": false
    },
    "keywords": [
        "64756b"
    ],
    "attributes": {
        "owner": {
            "type": "string",
            "default": ""
        },
        "repo": {
            "type": "string",
            "default": ""
        },
        "path": {
            "type": "string",
            "default": "changelog.txt"
        },
        "branch": {
            "type": "string",
            "default": "main"
        },
        "max_versions": {
            "type": "integer",
            "default": 5
        }
    },
    "textdomain": "stellarwp-changelog-embed",
    "editorScript": "file:./index.js"
}
